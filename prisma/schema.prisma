generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoMovimiento {
  ENTRADA
  VENTA
}

// Maestro de Ítems (F4101)
model F4101 {
  itm   Int      @id @default(autoincrement()) // Short Item No (consecutivo)

  // --- Basic Item Data ---
  litm  String?  // Item Number / Catalog Number
  dsc1  String   // Description (obligatorio)
  dsc2  String?  // Description 2
  srtx  String?  // Search Text
  stkt  String   // Stocking Type (obligatorio)
  glpt  String?  // G/L Class
  uom1  String?  // Unit of Measure (primaria)
  lnty  String?  @default("S") // Line Type
  bpfg  String?  @default("P") // Bulk/Packed Flag
  plnr  String?  // Planner Number
  buyr  String?  // Buyer Number
  bkor  Boolean  @default(true) // Backorders Allowed
  chkav Boolean  @default(true) // Check Availability
  cmcg  Int?     @default(2) // Inventory Cost Level
  sals  Int?     @default(2) // Sales Price Level
  purl  Int?     @default(3) // Purchase Price Level
  kitp  String?  // Kit/Configurator Pricing Method
  cfgc  String?  // Configurator Costing Method
  cmmt  Int?     @default(1) // Commitment Method
  prtm  String?  // Print Message
  flsh  String?  // Item Flash Message
  uomc  String?  // Std UOM Conversion
  stmn  Int?     @default(0) // Stock mínimo (alerta cuando stock <= stmn)

  // --- Additional Info. ---
  srp1  String?  // Sales Code 1
  srp2  String?  // Sales Code 2
  srp3  String?  // Sales Code 3
  prp1  String?  // Purchasing Code 1
  prp2  String?  // Purchasing Code 2
  cmcl  String?  // Commodity Class
  cmgl  String?  // Commodity Sub Class
  abcs  String?  // ABC Code - Sales
  abcm  String?  // ABC Code - Margin
  abci  String?  // ABC Code - Investment

  // --- Weights and Measures ---
  uom2  String?  // Secondary UOM
  uom3  String?  // Purchasing UOM
  uom4  String?  // Pricing UOM
  uom6  String?  // Shipping UOM
  uom8  String?  // Production UOM
  uom9  String?  // Component UOM
  uwum  String?  // Weight Unit of Measure
  uwgt  Float?   // Unit Weight
  vumd  String?  // Volume Unit of Measure
  uvol  Float?   // Unit Volume

  // --- Lot Processing ---
  lotc  String?  // Lot Process Type
  lots  String?  // Lot Status Code
  lotd  Int?     // Lot Effectivity Days
  shlf  Int?     // Shelf Life Days
  expm  String?  // Expiration Date Calculation
  lotr  Boolean  @default(false) // Lot Number Required
  serr  Boolean  @default(false) // Serial Number Required

  movimientos Movimiento[]

  @@map("F4101")
}

// Movimientos de stock (entradas y ventas)
model Movimiento {
  id       Int            @id @default(autoincrement())
  itm      Int
  tipo     TipoMovimiento
  cantidad Int
  nota     String?
  fecha    DateTime       @default(now())
  item     F4101          @relation(fields: [itm], references: [itm], onDelete: Cascade)

  @@index([itm])
  @@map("F4111")
}